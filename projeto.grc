- name: snippet_0
  id: snippet
  parameters:
    alias: ''
    code: "from PyQt5 import QtCore\n\n# Channel sweep setup\nchannels = [\n    2412000000,\
      \ 2417000000, 2422000000, 2427000000, 2432000000, 2437000000,\n    2442000000,\
      \ 2447000000, 2452000000, 2457000000, 2462000000, 2467000000,\n    2472000000,\
      \ 2484000000, 5160000000, 5180000000, 5200000000, 5220000000,\n    5240000000,\
      \ 5260000000, 5280000000, 5300000000, 5320000000, 5340000000,\n    5480000000,\
      \ 5500000000, 5520000000, 5540000000, 5560000000, 5580000000,\n    5600000000,\
      \ 5620000000, 5640000000, 5660000000, 5680000000, 5700000000,\n    5720000000,\
      \ 5745000000, 5765000000, 5785000000, 5805000000, 5825000000,\n    5845000000,\
      \ 5865000000, 5885000000\n]\nchannel_index = [0]\ntb = self  # Captura refer\xEA\
      ncia do top_block\n\ndef sweep_channel():\n    try:\n        print(f\"[SWEEP]\
      \ Mudando para canal {channel_index[0]+1}/{len(channels)}...\")\n        tb.set_freq(channels[channel_index[0]])\n\
      \        print(f\"[SWEEP] Agora em: {channels[channel_index[0]]/1e9:.3f} GHz\"\
      )\n        channel_index[0] = (channel_index[0] + 1) % len(channels)\n    except\
      \ Exception as e:\n        print(f\"[SWEEP] ERRO: {e}\")\n\nprint(\"[SWEEP]\
      \ Iniciando sweep autom\xE1tico de canais WiFi...\")\n\n# Criar timer e guardar\
      \ como atributo do top_block para n\xE3o ser coletado\nself._sweep_timer = QtCore.QTimer(self)\n\
      self._sweep_timer.timeout.connect(sweep_channel)\nself._sweep_timer.start(10000)\
      \  # 10000ms = 10 segundos\nprint(\"[SWEEP] Timer iniciado! Mudando de canal\
      \ a cada 10 segundos...\")"
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 656.0]
    rotation: 0
    state: enabled

